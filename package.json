{
  "name": "bitcoin-network-data-driven-geometry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pipeline": "node pipeline/fetch_coinmetrics.mjs && node pipeline/fetch_blockchain.mjs && node pipeline/fetch_mempool.mjs && node pipeline/ingest_bigquery.mjs && node pipeline/build_db.mjs && node pipeline/export_json.mjs",
