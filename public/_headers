# Cloudflare Pages custom headers. Applied to every response.
# See https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Block framing (clickjacking defense)
  X-Frame-Options: DENY
  # Prevent MIME sniffing
  X-Content-Type-Options: nosniff
  # Minimise what URL info leaks cross-origin
  Referrer-Policy: strict-origin-when-cross-origin
  # Deny all powerful features — this app needs none of them
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), autoplay=()
  # HSTS: force HTTPS for 1 year + preload eligibility
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # No Flash / Silverlight cross-domain policy
  X-Permitted-Cross-Domain-Policies: none
  # DuckDB-WASM loading chain:
  #   main thread → new Worker(blob: URL containing inline importScripts)
  #                   → importScripts('https://cdn.jsdelivr.net/.../worker.js')
  #                     → fetch('https://cdn.jsdelivr.net/.../duckdb-eh.wasm')
  # 'unsafe-inline' on script-src is required because the blob: Worker's body
  # is treated as an inline script. blob: covers the Worker URL itself;
  # cdn.jsdelivr.net covers the importScripts target and the WASM fetch.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Parquet files are static — cache hard
/data/*.parquet
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
