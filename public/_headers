# Cloudflare Pages custom headers. Applied to every response.
# See https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Block framing (clickjacking defense)
  X-Frame-Options: DENY
  # Prevent MIME sniffing
  X-Content-Type-Options: nosniff
  # Minimise what URL info leaks cross-origin
  Referrer-Policy: strict-origin-when-cross-origin
  # Deny all powerful features — this app needs none of them
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), autoplay=()
  # HSTS: force HTTPS for 1 year + preload eligibility
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # No Flash / Silverlight cross-domain policy
  X-Permitted-Cross-Domain-Policies: none
  # CSP intentionally omitted. Every combination we tried silently broke
  # DuckDB-WASM's blob-Worker + importScripts(jsDelivr) loading chain in
  # ways that didn't surface as CSP violations — just a silent WASM
  # "function signature mismatch" because partially-loaded worker code
  # couldn't construct the right imports. The headers above still harden
  # the site (clickjacking blocked, no powerful features, HTTPS enforced,
  # referrer minimized, no MIME sniffing, no Flash cross-domain). The
  # app also never touches user input, cookies, or storage, so the XSS
  # surface CSP would cover is effectively nil here.

# Parquet files are static — cache hard
/data/*.parquet
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
